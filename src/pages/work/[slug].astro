---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MarginRow from '../../components/MarginRow.astro';
import Stamp from '../../components/Stamp.astro';
import StackList from '../../components/StackList.astro';
import Quote from '../../components/Quote.astro';
import Glyph from '../../components/Glyph.astro';
import ContactSet from '../../components/ContactSet.astro';
import { getEndorsements, getProfile, getSkills, getWork, type Work } from '../../lib/content';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w, i) => ({
    params: { slug: w.id },
    props: { work: w, next: work[(i + 1) % work.length] },
  }));
}

interface Props {
  work: Work;
  next: Work;
}

const { work, next } = Astro.props;
const w = work.data;
const { Content, headings } = await render(work);
// "On this page": the sub-headings of the case study (C-08).
const contents = headings.filter((h) => h.depth === 3);
const [allSkills, profile, endorsements] = await Promise.all([getSkills(), getProfile(), getEndorsements()]);
// At most one recommendation on a project page: one that names this project (DS5).
const endorsement = endorsements.find((e) => e.data.work?.id === work.id);
const skills = w.skills.flatMap((ref) => allSkills.filter((s) => s.id === ref.id));
---

<Base title={`${w.title} — Raymundo Oyong`} description={w.line} slimFooter>
  <MarginRow index={0}>
    <Fragment slot="label">
      No. {w.no} <br />Project
      <span class="label-stamp"><Stamp status={w.status} press={false} /></span>
    </Fragment>
    <header class="cs-head">
      <div class="cs-hero">
        <div>
          <h1 class="display cs-name" transition:name={`work-${work.id}`}>{w.title}</h1>
          <p class="cs-line">{w.line}</p>
        </div>
        <div class="cs-glyph" aria-hidden="true">
          <Glyph work={work.id} width={280} />
          <span class="glyph-stamp"><Stamp status={w.status} /></span>
        </div>
      </div>
      <p class="byline">By {profile.name}, {profile.title}</p>
      <dl class="meta">
        <div>
          <dt class="label">Role</dt>
          <dd>{w.role}</dd>
        </div>
        <div>
          <dt class="label">When</dt>
          <dd>{w.period}</dd>
        </div>
        <div>
          <dt class="label">Built for</dt>
          <dd>{w.client}</dd>
        </div>
        <div class="built-with">
          <dt class="label">Built with</dt>
          <dd><StackList items={w.stack} /></dd>
        </div>
      </dl>
      {
        contents.length > 0 && (
          <nav class="toc" aria-labelledby="toc-label">
            <p class="label" id="toc-label">
              On this page
            </p>
            <ol class="mono">
              {contents.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="target">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </header>
  </MarginRow>

  <Content />

  {
    endorsement && (
      <MarginRow ruled hideLabel>
        <Fragment slot="label">In their <br />words</Fragment>
        <h2 class="visually-hidden">In their words</h2>
        <div class="cs-quote">
          <Quote endorsement={endorsement} />
        </div>
      </MarginRow>
    )
  }

  <MarginRow ruled hideLabel>
    <Fragment slot="label">Skills <br />shown</Fragment>
    <h2 class="visually-hidden">Skills shown</h2>
    <ul class="tags">
      {
        skills.map((s) => (
          <li>
            <a href={`/#${s.id}`} class="tag target">
              {s.data.name} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </MarginRow>

  <!-- The end of a case study is where a reader decides to get in touch (FIX_PLAN D-08). -->
  <MarginRow ruled hideLabel>
    <Fragment slot="label">Contact</Fragment>
    <div class="closing">
      <h2 class="title closing-ask">Want to talk about this work?</h2>
      <ContactSet class="closing-links" />
    </div>
  </MarginRow>

  <nav aria-label="More work" class="cs-nav">
    <a href={`/work/${next.id}/`} class="next">
      <span class="mono muted next-label">Next · No. {next.data.no}</span>
      <span class="display next-title">{next.data.title} <span aria-hidden="true">→</span></span>
      <span class="next-line">{next.data.short}</span>
      <Glyph work={next.id} width={120} class="next-glyph" />
    </a>
    <a href="/#work" class="mono target all-work">← All work</a>
  </nav>
</Base>

<style>
  .label-stamp {
    display: block;
    margin-top: 16px;
  }

  .cs-head {
    padding: 32px 0 16px;
  }

  .cs-name {
    font-size: clamp(56px, 10vw, 132px);
    line-height: 0.9;
  }

  .cs-line {
    margin-top: 24px;
    font-size: clamp(21px, 2.4vw, 28px);
    line-height: 1.35;
    max-width: 26em;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 48px;
    border-top: 2px solid var(--ink);
  }

  .meta > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 16px 4px;
    border-right: 1px solid var(--rule);
  }

  .meta > div:first-child {
    padding-left: 0;
  }

  .meta > div:last-child {
    border-right: 0;
  }

  .meta dd {
    font-size: 17px;
    line-height: 1.4;
  }

  .toc {
    margin-top: var(--space-6);
  }

  .toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--type-mono);
  }

  .toc a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  .byline {
    margin-top: 16px;
    font-size: 16px;
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-family: var(--font-display);
    font-stretch: 78%;
    font-weight: 700;
    font-size: 22px;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .cs-quote {
    padding: 8px 0 8px;
  }

  .closing {
    padding: 8px 0 16px;
  }

  .closing-ask {
    font-size: clamp(28px, 4vw, 40px);
  }

  .closing :global(.closing-links) {
    margin-top: var(--space-5);
  }

  /* The project's glyph beside its name on wide screens, the status stamped on it. */
  .cs-glyph {
    display: none;
  }

  @media (min-width: 1100px) {
    .cs-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: var(--space-8);
      align-items: start;
    }

    .cs-glyph {
      position: relative;
      display: block;
      margin-top: var(--space-5);
    }

    .glyph-stamp {
      position: absolute;
      right: -8px;
      bottom: -14px;
    }

    .label-stamp {
      display: none;
    }
  }

  /* Next project: a panel that keeps the reader in the evidence (C-09). */
  .cs-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) 0 var(--space-8);
    border-top: 2px solid var(--ink);
  }

  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px;
    grid-template-areas: 'label glyph' 'title glyph' 'line glyph';
    gap: var(--space-2) var(--space-6);
    align-items: start;
    padding: var(--space-3) 0;
    text-decoration: none;
  }

  .next-label {
    grid-area: label;
    font-size: var(--type-mono-s);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .next-title {
    grid-area: title;
    font-size: clamp(40px, 6vw, 72px);
  }

  .next-line {
    grid-area: line;
    max-width: 36em;
    color: var(--ink-2);
  }

  .next :global(.next-glyph) {
    grid-area: glyph;
    align-self: center;
  }

  @media (hover: hover) {
    .next:hover .next-title {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
  }

  .all-work {
    align-self: flex-start;
    font-size: var(--type-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .next {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'glyph' 'label' 'title' 'line';
    }
  }

  @media (max-width: 900px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meta > div:nth-child(2n) {
      border-right: 0;
    }

    .meta > div:nth-child(2n + 1) {
      padding-left: 0;
    }

    .meta > div:nth-child(-n + 2) {
      padding-bottom: 16px;
      border-bottom: 1px solid var(--rule);
    }

    /* "Built with" is the longest list: it takes the whole row. */
    .meta > .built-with {
      grid-column: 1 / -1;
      padding-left: 0;
      border-right: 0;
    }
  }

  @media (max-width: 760px) {
    .label-stamp {
      display: inline-block;
      margin: 0 0 0 12px;
    }
  }
</style>
