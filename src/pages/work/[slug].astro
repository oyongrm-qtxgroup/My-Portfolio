---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MarginRow from '../../components/MarginRow.astro';
import Stamp from '../../components/Stamp.astro';
import StackList from '../../components/StackList.astro';
import Quote from '../../components/Quote.astro';
import { getEndorsements, getProfile, getSkills, getWork, type Work } from '../../lib/content';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w, i) => ({
    params: { slug: w.id },
    props: { work: w, next: work[(i + 1) % work.length] },
  }));
}

interface Props {
  work: Work;
  next: Work;
}

const { work, next } = Astro.props;
const w = work.data;
const { Content } = await render(work);
const [allSkills, profile, endorsements] = await Promise.all([getSkills(), getProfile(), getEndorsements()]);
// At most one recommendation on a project page: one that names this project (DS5).
const endorsement = endorsements.find((e) => e.data.work?.id === work.id);
const skills = w.skills.flatMap((ref) => allSkills.filter((s) => s.id === ref.id));
---

<Base title={`${w.title} — Raymundo Oyong`} description={w.line}>
  <MarginRow index={0}>
    <Fragment slot="label">
      No. {w.no} <br />Project
      <span class="label-stamp"><Stamp status={w.status} press={false} /></span>
    </Fragment>
    <header class="cs-head">
      <h1 class="display cs-name" transition:name={`work-${work.id}`}>{w.title}</h1>
      <p class="cs-line">{w.line}</p>
      <p class="byline">By {profile.name}, {profile.title}</p>
      <dl class="meta">
        <div>
          <dt class="label">Role</dt>
          <dd>{w.role}</dd>
        </div>
        <div>
          <dt class="label">When</dt>
          <dd>{w.period}</dd>
        </div>
        <div>
          <dt class="label">Built for</dt>
          <dd>{w.client}</dd>
        </div>
        <div class="built-with">
          <dt class="label">Built with</dt>
          <dd><StackList items={w.stack} /></dd>
        </div>
      </dl>
    </header>
  </MarginRow>

  <Content />

  {
    endorsement && (
      <MarginRow ruled hideLabel>
        <Fragment slot="label">In their <br />words</Fragment>
        <h2 class="visually-hidden">In their words</h2>
        <div class="cs-quote">
          <Quote endorsement={endorsement} />
        </div>
      </MarginRow>
    )
  }

  <MarginRow ruled hideLabel>
    <Fragment slot="label">Skills <br />shown</Fragment>
    <h2 class="visually-hidden">Skills shown</h2>
    <ul class="tags">
      {
        skills.map((s) => (
          <li>
            <a href={`/#${s.id}`} class="tag target">
              {s.data.name} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </MarginRow>

  <!-- The end of a case study is where a reader decides to get in touch (FIX_PLAN D-08). -->
  <MarginRow ruled hideLabel>
    <Fragment slot="label">Contact</Fragment>
    <div class="closing">
      <h2 class="title closing-ask">Want to talk about this work?</h2>
      <p class="closing-links">
        <a href={`mailto:${profile.email}`} class="accent target">{profile.email}</a>
        <a href="/raymundo-oyong-cv.pdf" class="accent target" download>Download CV</a>
      </p>
    </div>
  </MarginRow>

  <nav aria-label="More work" class="cs-nav mono">
    <a href="/#work" class="target">← All work</a>
    <a href={`/work/${next.id}/`} class="target accent">No. {next.data.no} {next.data.title} →</a>
  </nav>
</Base>

<style>
  .label-stamp {
    display: block;
    margin-top: 16px;
  }

  .cs-head {
    padding: 32px 0 16px;
  }

  .cs-name {
    font-size: clamp(56px, 10vw, 132px);
    line-height: 0.9;
  }

  .cs-line {
    margin-top: 24px;
    font-size: clamp(21px, 2.4vw, 28px);
    line-height: 1.35;
    max-width: 26em;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 48px;
    border-top: 2px solid var(--ink);
  }

  .meta > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 16px 4px;
    border-right: 1px solid var(--rule);
  }

  .meta > div:first-child {
    padding-left: 0;
  }

  .meta > div:last-child {
    border-right: 0;
  }

  .meta dd {
    font-size: 17px;
    line-height: 1.4;
  }

  .byline {
    margin-top: 16px;
    font-size: 16px;
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-family: var(--font-display);
    font-stretch: 78%;
    font-weight: 700;
    font-size: 22px;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .cs-quote {
    padding: 8px 0 8px;
  }

  .closing {
    padding: 8px 0 16px;
  }

  .closing-ask {
    font-size: clamp(28px, 4vw, 40px);
  }

  .closing-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin-top: 12px;
    font-size: 19px;
  }

  .cs-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0 40px;
    border-top: 2px solid var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 900px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meta > div:nth-child(2n) {
      border-right: 0;
    }

    .meta > div:nth-child(2n + 1) {
      padding-left: 0;
    }

    .meta > div:nth-child(-n + 2) {
      padding-bottom: 16px;
      border-bottom: 1px solid var(--rule);
    }

    /* "Built with" is the longest list: it takes the whole row. */
    .meta > .built-with {
      grid-column: 1 / -1;
      padding-left: 0;
      border-right: 0;
    }
  }

  @media (max-width: 760px) {
    .label-stamp {
      display: inline-block;
      margin: 0 0 0 12px;
    }
  }
</style>
