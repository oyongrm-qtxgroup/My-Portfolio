---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MarginRow from '../../components/MarginRow.astro';
import Stamp from '../../components/Stamp.astro';
import NoteItem from '../../components/NoteItem.astro';
import { getNotes, getWork, type Work } from '../../lib/content';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w, i) => ({
    params: { slug: w.id },
    props: { work: w, next: work[(i + 1) % work.length] },
  }));
}

interface Props {
  work: Work;
  next: Work;
}

const { work, next } = Astro.props;
const w = work.data;
const { Content } = await render(work);
const notes = (await getNotes()).filter((n) => n.data.work?.id === work.id);
---

<Base title={`${w.title} — R. Oyong`} description={w.line}>
  <MarginRow index={0}>
    <Fragment slot="label">
      No. {w.no}<br />Case study
      <span class="label-stamp"><Stamp status={w.status} press={false} /></span>
    </Fragment>
    <header class="cs-head">
      <h1 class="display cs-name" transition:name={`work-${work.id}`}>{w.title}</h1>
      <p class="cs-line">{w.line}</p>
      <dl class="meta">
        <div>
          <dt class="label">Role</dt>
          <dd>{w.role}</dd>
        </div>
        <div>
          <dt class="label">When</dt>
          <dd>{w.period}</dd>
        </div>
        <div>
          <dt class="label">Built for</dt>
          <dd>{w.client}</dd>
        </div>
        <div>
          <dt class="label">Built with</dt>
          <dd>{w.stack.join(', ')}</dd>
        </div>
      </dl>
    </header>
  </MarginRow>

  <Content />

  {
    notes.length > 0 && (
      <MarginRow ruled>
        <Fragment slot="label">
          Notes from
          <br />
          this project
        </Fragment>
        <h2 class="visually-hidden">Notes from this project</h2>
        <div class="notes">
          {notes.map((note) => (
            <NoteItem note={note} variant="teaser" headingLevel={3} />
          ))}
        </div>
      </MarginRow>
    )
  }

  <nav aria-label="More work" class="cs-nav mono">
    <a href="/#work" class="target">← All work</a>
    <a href={`/work/${next.id}/`} class="target accent">No. {next.data.no} {next.data.title} →</a>
  </nav>
</Base>

<style>
  .label-stamp {
    display: block;
    margin-top: 16px;
  }

  .cs-head {
    padding: 32px 0 16px;
  }

  .cs-name {
    font-size: clamp(56px, 10vw, 132px);
    line-height: 0.9;
  }

  .cs-line {
    margin-top: 24px;
    font-size: clamp(21px, 2.4vw, 28px);
    line-height: 1.35;
    max-width: 26em;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 48px;
    border-top: 2px solid var(--ink);
  }

  .meta > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 16px 4px;
    border-right: 1px solid var(--rule);
  }

  .meta > div:first-child {
    padding-left: 0;
  }

  .meta > div:last-child {
    border-right: 0;
  }

  .meta dd {
    font-size: 17px;
    line-height: 1.4;
  }

  .notes {
    margin-top: -24px;
  }

  .cs-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0 40px;
    border-top: 2px solid var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 900px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meta > div:nth-child(2n) {
      border-right: 0;
    }

    .meta > div:nth-child(2n + 1) {
      padding-left: 0;
    }

    .meta > div:nth-child(-n + 2) {
      padding-bottom: 16px;
      border-bottom: 1px solid var(--rule);
    }
  }

  @media (max-width: 760px) {
    .label-stamp {
      display: inline-block;
      margin: 0 0 0 12px;
    }
  }
</style>
