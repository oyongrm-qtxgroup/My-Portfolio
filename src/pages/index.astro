---
import Base from '../layouts/Base.astro';
import MarginRow from '../components/MarginRow.astro';
import WorkRow from '../components/WorkRow.astro';
import LogRow from '../components/LogRow.astro';
import { getLog, getProfile, getRoles, getWork } from '../lib/content';

const [profile, work, log, roles] = await Promise.all([
  getProfile(),
  getWork(),
  getLog(),
  getRoles(),
]);

const footnotes = [
  'Jayne Bandy AI — an AI receptionist for dental practices',
  'A finance system for a retirement-village operator',
  'A workforce and care platform for an NDIS provider',
];

const recent = log.slice(0, 7);
const before = roles.filter((r) => !r.data.current);
const nowDate = profile.now.date.toLocaleDateString('en-AU', {
  day: '2-digit',
  month: '2-digit',
  year: '2-digit',
  timeZone: 'UTC',
});
---

<Base>
  <MarginRow index={0}>
    <Fragment slot="label">§ 00<br />Intro</Fragment>
    <div class="hero">
      <h1 class="display headline">
        <span class="ln" style="--i: 0">I build the software</span>
        <span class="ln" style="--i: 1">that answers the phone<sup>1</sup>,</span>
        <span class="ln" style="--i: 2">bills the residents<sup>2</sup></span>
        <span class="ln" style="--i: 3">and rosters the carers<sup>3</sup>.</span>
      </h1>
      <p class="lede fade" style="--i: 2">
        {profile.title.charAt(0).toUpperCase() + profile.title.slice(1)} at QTX. I take products from
        a client's first call to the version people rely on every day: voice agents, finance engines,
        award-pay rules, and the integrations that hold them together.
      </p>
      <ol class="notes mono muted fade" style="--i: 3">
        {
          footnotes.map((note, i) => (
            <li>
              <span class="accent">{i + 1}</span>
              {note}
            </li>
          ))
        }
      </ol>
      <p class="mono muted where fade" style="--i: 4">
        {profile.location} ·{' '}
        <a href={`mailto:${profile.email}`} class="accent">{profile.email}</a>
      </p>
    </div>
  </MarginRow>

  <MarginRow index={1}>
    <Fragment slot="label">Now<br />{nowDate.replaceAll('/', '.')}</Fragment>
    <div class="now fade" style="--i: 5">
      {profile.now.lines.map((line) => <p>{line}</p>)}
    </div>
  </MarginRow>

  <MarginRow index={2}>
    <Fragment slot="label">2026<br />in figures</Fragment>
    <dl class="figures">
      {
        profile.figures.map((f) => (
          <div>
            <dt class="label">{f.label}</dt>
            <dd class="display tabular">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </MarginRow>

  <MarginRow index={3} ruled id="work">
    <Fragment slot="label">§ 01<br />Work</Fragment>
    <h2 class="visually-hidden">Work</h2>
    <div class="list">
      {work.map((w, i) => <WorkRow work={w} index={i} />)}
    </div>
  </MarginRow>

  <MarginRow index={4} ruled>
    <Fragment slot="label">§ 02<br />Recent log</Fragment>
    <h2 class="visually-hidden">Recent log</h2>
    <div class="list">
      {recent.map((e, i) => <LogRow entry={e} index={i} />)}
    </div>
    <a href="/log/" class="mono accent more target">Read the full log →</a>
  </MarginRow>

  <MarginRow index={5} ruled>
    <Fragment slot="label">§ 03<br />Before QTX</Fragment>
    <h2 class="visually-hidden">Before QTX</h2>
    <div class="list">
      {
        before.map((r) => (
          <div class="role reveal">
            <span class="mono muted tabular">{r.data.span}</span>
            <span class="mono role-org">{r.data.org}</span>
            <p>
              <strong class="role-title">{r.data.title}.</strong> {r.data.summary}
            </p>
          </div>
        ))
      }
    </div>
  </MarginRow>

  <MarginRow index={6} ruled id="contact">
    <Fragment slot="label">§ 04<br />Write</Fragment>
    <div class="contact reveal">
      <h2 class="display ask">Got a phone line, a ledger or a roster that needs software?</h2>
      <a href={`mailto:${profile.email}`} class="accent email">{profile.email}</a>
      <ul class="mono links">
        <li><a href={profile.links.linkedin} class="target">LinkedIn</a></li>
        <li><a href={profile.links.github} class="target">GitHub</a></li>
      </ul>
    </div>
  </MarginRow>
</Base>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 16px;
  }

  .headline {
    font-size: clamp(44px, 7.4vw, 92px);
    max-width: 20ch;
  }

  .headline sup {
    font: 500 0.2em var(--font-mono);
    color: var(--accent);
    vertical-align: top;
    margin-left: 4px;
  }

  .lede {
    margin-top: 40px;
  }

  .notes {
    margin-top: 40px;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .notes li {
    display: flex;
    gap: 12px;
  }

  .where {
    margin-top: 28px;
  }

  .now {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 19px;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: -24px 0 -40px;
  }

  .figures > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 20px 32px;
    border-right: 1px solid var(--rule);
  }

  .figures > div:first-child {
    padding-left: 0;
  }

  .figures > div:last-child {
    border-right: 0;
  }

  .figures dd {
    order: -1;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
  }

  .list {
    margin-top: -8px;
  }

  .more {
    margin-top: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role {
    display: grid;
    grid-template-columns: 72px 190px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .role-org {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role p {
    font-size: 18px;
    line-height: 1.45;
  }

  .role-title {
    font-weight: 600;
  }

  .contact {
    padding: 16px 0 24px;
  }

  .ask {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
    max-width: 18ch;
  }

  .email {
    display: inline-block;
    margin-top: 28px;
    font-size: clamp(22px, 3vw, 30px);
    text-underline-offset: 6px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 900px) {
    .role {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 6px 14px;
    }

    .role p {
      grid-column: 1 / -1;
      font-size: 17px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 8px;
    }

    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
    }

    .figures > div {
      padding: 18px 16px 18px 0;
      border-bottom: 1px solid var(--rule);
    }

    .figures > div:nth-child(2n) {
      border-right: 0;
      padding-left: 16px;
    }

    .figures > div:nth-child(n + 3) {
      border-bottom: 0;
    }
  }
</style>
