---
import Base from '../layouts/Base.astro';
import MarginRow from '../components/MarginRow.astro';
import WorkRow from '../components/WorkRow.astro';
import NoteItem from '../components/NoteItem.astro';
import { getNotes, getProfile, getRoles, getWork } from '../lib/content';

const [profile, work, notes, roles] = await Promise.all([
  getProfile(),
  getWork(),
  getNotes(),
  getRoles(),
]);

const footnotes = [
  'Jayne Bandy AI — an AI receptionist for dental practices',
  'A finance system for a retirement-village operator',
  'A workforce and care platform for a disability-support provider',
];

const before = roles.filter((r) => !r.data.current);
---

<Base>
  <MarginRow index={0}>
    <Fragment slot="label">§ 00<br />Intro</Fragment>
    <div class="hero">
      <h1 class="display headline">
        <span class="ln" style="--i: 0">I build the software</span>
        <span class="ln" style="--i: 1">that answers the phone<sup>1</sup>,</span>
        <span class="ln" style="--i: 2">bills the residents<sup>2</sup></span>
        <span class="ln" style="--i: 3">and rosters the carers<sup>3</sup>.</span>
      </h1>
      <p class="lede fade" style="--i: 2">
        I'm Raymundo, an AI product engineer. I take products from a client's first call to the
        version people rely on every day: voice agents, finance engines, award-pay rules, and the
        integrations that hold them together.
      </p>
      <ol class="notes mono muted fade" style="--i: 3">
        {
          footnotes.map((note, i) => (
            <li>
              <span class="accent">{i + 1}</span>
              {note}
            </li>
          ))
        }
      </ol>
      <p class="mono muted where fade" style="--i: 4">
        {profile.location} ·{' '}
        <a href={`mailto:${profile.email}`} class="accent">{profile.email}</a>
      </p>
    </div>
  </MarginRow>

  <MarginRow index={1}>
    <Fragment slot="label">Now</Fragment>
    <p class="now fade" style="--i: 5">{profile.now}</p>
  </MarginRow>

  <MarginRow index={2} ruled id="work">
    <Fragment slot="label">§ 01<br />Work</Fragment>
    <h2 class="visually-hidden">Work</h2>
    <div class="list">
      {work.map((w, i) => <WorkRow work={w} index={i} />)}
    </div>
  </MarginRow>

  <MarginRow index={3} ruled>
    <Fragment slot="label">§ 02<br />Notes</Fragment>
    <h2 class="visually-hidden">Notes</h2>
    <div class="list">
      {notes.slice(0, 3).map((note) => <NoteItem note={note} variant="teaser" headingLevel={3} />)}
    </div>
    <a href="/notes/" class="mono accent more target">All {notes.length} notes →</a>
  </MarginRow>

  <MarginRow index={4} ruled>
    <Fragment slot="label">§ 03<br />Before QTX</Fragment>
    <h2 class="visually-hidden">Before QTX</h2>
    <div class="list">
      {
        before.map((r) => (
          <div class="role reveal">
            <span class="mono muted tabular">{r.data.span}</span>
            <span class="mono role-org">{r.data.org}</span>
            <p>
              <strong class="role-title">{r.data.title}.</strong> {r.data.summary}
            </p>
          </div>
        ))
      }
    </div>
  </MarginRow>

  <MarginRow index={5} ruled id="contact">
    <Fragment slot="label">§ 04<br />Write</Fragment>
    <div class="contact reveal">
      <h2 class="display ask">Got a phone line, a ledger or a roster that needs software?</h2>
      <a href={`mailto:${profile.email}`} class="accent email">{profile.email}</a>
      <ul class="mono links">
        <li><a href={profile.links.linkedin} class="target">LinkedIn</a></li>
        <li><a href={profile.links.github} class="target">GitHub</a></li>
      </ul>
    </div>
  </MarginRow>
</Base>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 16px;
  }

  .headline {
    font-size: clamp(44px, 7.4vw, 92px);
    max-width: 20ch;
  }

  .headline sup {
    font: 500 0.2em var(--font-mono);
    color: var(--accent);
    vertical-align: top;
    margin-left: 4px;
  }

  .lede {
    margin-top: 40px;
  }

  .notes {
    margin-top: 40px;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .notes li {
    display: flex;
    gap: 12px;
  }

  .where {
    margin-top: 28px;
  }

  .now {
    font-size: 19px;
    max-width: 40em;
  }

  .list {
    margin-top: -8px;
  }

  .more {
    margin-top: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role {
    display: grid;
    grid-template-columns: 72px 190px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .role-org {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role p {
    font-size: 18px;
    line-height: 1.45;
  }

  .role-title {
    font-weight: 600;
  }

  .contact {
    padding: 16px 0 24px;
  }

  .ask {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
    max-width: 18ch;
  }

  .email {
    display: inline-block;
    margin-top: 28px;
    font-size: clamp(22px, 3vw, 30px);
    text-underline-offset: 6px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 900px) {
    .role {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 6px 14px;
    }

    .role p {
      grid-column: 1 / -1;
      font-size: 17px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 8px;
    }
  }
</style>
