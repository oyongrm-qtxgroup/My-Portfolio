---
import Base from '../layouts/Base.astro';
import MarginRow from '../components/MarginRow.astro';
import WorkRow from '../components/WorkRow.astro';
import ContactForm from '../components/ContactForm.astro';
import Years from '../components/Years.astro';
import Portrait from '../components/Portrait.astro';
import { homeGraph } from '../lib/schema';
import { getRepos, pushedOn } from '../lib/github';
import Quote from '../components/Quote.astro';
import ContactSet from '../components/ContactSet.astro';
import ProofGrid from '../components/ProofGrid.astro';
import Timeline from '../components/Timeline.astro';
import { getEndorsements, getPrinciples, getProfile, getRoles, getSkills, getWork } from '../lib/content';

const [profile, skills, principles, work, roles, repos, endorsements] = await Promise.all([
  getProfile(),
  getSkills(),
  getPrinciples(),
  getWork(),
  getRoles(),
  getRepos(),
  getEndorsements(),
]);
// Two or three on the home page (DS5); every recommendation is on LinkedIn.
const quotes = endorsements.filter((e) => e.data.home).slice(0, 3);
const recommendations = new URL('details/recommendations/', profile.links.linkedin).href;

// Work first (docs/FIX_PLAN.md D4): the projects are the evidence, so they come before
// the capabilities they prove (the proof grid links each area to its proof).
const workById = new Map(work.map((w) => [w.id, w]));

// The availability line, set as labelled facts beside the portrait. The words are the
// profile's own, split at "Open to" and the time zone; anything else shows whole.
const parts = profile.availability.match(/^Open to (.+?)\s+(UTC[+−-]\d+)\.?$/s);
const openTo = parts ? parts[1] : profile.availability;
const hours = parts?.[2];
const checked = new Date(`${profile.availabilityChecked}-01T00:00:00Z`).toLocaleDateString('en-AU', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

// schema.org for search engines: the Person and the WebSite (src/lib/schema.ts).
const jsonLd = homeGraph(Astro.site!, profile, roles, skills);
---

<Base description={profile.summary} jsonLd={jsonLd} slimFooter>
  <MarginRow index={0} hideLabel headed>
    <Fragment slot="label">Intro</Fragment>
    <div class="hero">
      <h1 class="display headline">
        {/* The space keeps the words apart for screen readers and the phone layout below. */}
        {profile.headline.map((line, i) => (
          <Fragment>
            <span class="ln" style={`--i: ${i}`}>{line}</span>{' '}
          </Fragment>
        ))}
      </h1>
      <div class="identity-row">
        <Portrait crop="face" width={88} class="face" />
        <p class="identity">
          <span class="identity-name">{profile.name}</span>
          <span class="identity-title">{profile.title}</span>
        </p>
      </div>
      <p class="actions">
        <a href="/raymundo-oyong-cv.pdf" class="action primary" download>Download CV</a>
        <a href="#work" class="action">Selected work</a>
      </p>
      <!-- Who, available for what, when and how to reach: one glanceable block. -->
      <div class="facts">
        <Portrait crop="full" width={220} class="figure" />
        <dl class="fact-list">
          {
            parts ? (
              <div>
                <dt class="label">Open to</dt>
                <dd>{openTo}</dd>
              </div>
            ) : (
              <div>
                <dt class="visually-hidden">Availability</dt>
                <dd>{openTo}</dd>
              </div>
            )
          }
          {
            hours && (
              <div>
                <dt class="label">Hours</dt>
                <dd>{hours}</dd>
              </div>
            )
          }
          <div>
            <dt class="label">Contact</dt>
            <dd>
              <a href={`mailto:${profile.email}`} class="accent target">{profile.email}</a>
            </dd>
          </div>
        </dl>
        <p class="mono muted checked">Availability checked {checked}</p>
      </div>
      <!-- Not faded: the largest text block on a phone must paint at once (LCP). -->
      <p class="lede">{profile.lede}</p>
      <p class="mono muted where">{profile.location}</p>
    </div>
  </MarginRow>

  <MarginRow index={1}>
    <Fragment slot="label">In <br />figures</Fragment>
    <dl class="figures fade" style="--i: 4">
      {
        profile.figures.map((f) => {
          const project = workById.get(f.work.id);
          return (
            <div class="figure-cell">
              <dt class="fig-label">{f.label}</dt>
              <dd class="display tabular">{f.value}</dd>
              {project && (
                <dd class="mono fig-source">
                  <a href={`/work/${project.id}/`} class="fig-link">
                    {project.data.title} →
                  </a>
                </dd>
              )}
            </div>
          );
        })
      }
    </dl>
  </MarginRow>

  <MarginRow index={2} ruled id="work" hideLabel>
    <Fragment slot="label">Selected <br />work<span class="phone-only"> · {work.length}</span></Fragment>
    <h2 class="visually-hidden">Selected work</h2>
    <div class="list">
      {work.map((w, i) => <WorkRow work={w} index={i} />)}
    </div>
  </MarginRow>

  <MarginRow index={3} ruled id="experience" hideLabel>
    <Fragment slot="label">Experience</Fragment>
    <h2 class="visually-hidden">Experience</h2>
    <Timeline roles={roles} now={profile.updated} />
    <div class="list">
      {
        roles.map((r) => (
          <div class="role reveal" id={`role-${r.id}`}>
            <Years start={r.data.start} end={r.data.end} class="mono muted" />
            <span class="role-org">{r.data.short}</span>
            <p>
              <strong class="role-title">{r.data.title}.</strong> {r.data.summary}
            </p>
          </div>
        ))
      }
    </div>
    <a href="/cv/" class="mono accent more target">Full CV →</a>
  </MarginRow>

  {
    /* Proof (DESIGN_PLAN DS5): code, then what colleagues wrote. No nav item. */
    (repos.length > 0 || quotes.length > 0) && (
      <MarginRow index={4} ruled id="proof" hideLabel>
        <Fragment slot="label">Proof</Fragment>
        <h2 class="visually-hidden">Proof</h2>
        {repos.length > 0 && (
          <section class="proof-part" aria-labelledby="proof-code">
            <h3 class="label proof-kicker" id="proof-code">
              Code on GitHub ·{' '}
              <a href={profile.links.github} class="proof-account">
                {profile.links.github.replace(/^https:\/\//, '')}
              </a>
            </h3>
            <ul class="repos">
              {repos.map((r) => (
                <li class="repo reveal">
                  <h4 class="title repo-name">
                    <a href={r.url} class="target">
                      {r.name}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  </h4>
                  {r.line && <p class="repo-line">{r.line}</p>}
                  <p class="mono muted repo-meta">
                    {[r.language, pushedOn(r.pushed), r.archived && 'Archived'].filter(Boolean).join(' · ')}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )}
        {quotes.length > 0 && (
          <section class="proof-part" aria-labelledby="proof-words">
            <h3 class="label proof-kicker" id="proof-words">
              Recommendations
            </h3>
            <div class="quotes">
              {quotes.map((e) => (
                <Quote endorsement={e} />
              ))}
            </div>
            <p class="mono all-recs">
              <a href={recommendations} class="target">
                See all recommendations on LinkedIn ↗
              </a>
            </p>
          </section>
        )}
      </MarginRow>
    )
  }

  <MarginRow index={5} ruled id="capabilities" hideLabel>
    <Fragment slot="label">Capabilities</Fragment>
    <h2 class="visually-hidden">Capabilities</h2>
    <ProofGrid skills={skills} work={work} />
  </MarginRow>

  <MarginRow index={6} ruled id="principles" hideLabel>
    <Fragment slot="label">Principles</Fragment>
    <h2 class="visually-hidden">Principles</h2>
    <ol class="list principles">
      {
        principles.map((p, i) => (
          <li class="principle reveal">
            <span class="mono muted tabular">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="title principle-title">{p.data.title}</h3>
              <p>{p.data.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </MarginRow>

  <MarginRow index={7} ruled id="contact" hideLabel headed>
    <Fragment slot="label">Contact</Fragment>
    <div class="contact reveal">
      <div class="contact-main">
        <h2 class="display ask">Hiring for a role? Tell me about it.</h2>
        <p class="ask-sub">Email is the fastest way to reach me. Project enquiries are welcome too.</p>
        <ContactForm email={profile.email} />
      </div>
      <ContactSet class="contact-side" />
    </div>
  </MarginRow>
</Base>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 16px;
  }

  .headline {
    font-size: clamp(44px, 7.4vw, 92px);
    max-width: 20ch;
  }

  .identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    margin-top: 28px;
    font-family: var(--font-display);
    font-stretch: 80%;
    line-height: 1.1;
  }

  .identity-name {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
  }

  .identity-title {
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 500;
    color: var(--ink-2);
  }

  .lede {
    margin-top: 28px;
  }

  .where {
    margin-top: 20px;
  }

  .identity-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }

  .identity-row .identity {
    margin-top: 0;
  }

  .identity-row :global(.face) {
    flex: 0 0 88px;
  }

  .facts {
    margin-top: 28px;
    max-width: 36em;
  }

  .facts :global(.figure) {
    display: none;
  }

  .fact-list {
    margin: 0;
    border-top: 1.5px solid var(--ink);
  }

  .fact-list > div {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }

  .fact-list dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  .fact-list a {
    overflow-wrap: anywhere;
  }

  .checked {
    margin-top: 10px;
    font-size: 12px;
  }

  /* Wide screens: the portrait and the facts take the empty right of the hero. */
  @media (min-width: 1100px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 220px;
      grid-template-rows: auto auto auto auto auto 1fr;
      column-gap: 56px;
    }

    .headline {
      grid-column: 1 / -1;
    }

    .identity-row,
    .actions,
    .lede,
    .where {
      grid-column: 1;
    }

    .facts {
      grid-column: 2;
      grid-row: 2 / -1;
      margin-top: 32px;
    }

    .identity-row :global(.face) {
      display: none;
    }

    .facts :global(.figure) {
      display: block;
      width: 220px;
      margin-bottom: 20px;
    }

    .fact-list > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--ink);
    color: var(--ink);
    font: 500 13px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .action.primary {
    background: var(--ink);
    color: var(--paper);
  }

  /* Buttons invert ink and paper; blue is for text links only (FIX_PLAN D12). */
  @media (hover: hover) {
    .action:hover {
      background: var(--ink);
      color: var(--paper);
    }

    .action.primary:hover {
      background: var(--paper);
      color: var(--ink);
    }
  }

  .action:active {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .action.primary:active {
    outline: 2px solid var(--paper);
    outline-offset: -2px;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: -28px 0 0;
  }

  /* Stat labels in sentence case: they're facts people scan, not metadata. */
  .fig-label {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .figures > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 20px 32px;
    border-right: 1px solid var(--rule);
  }

  .figures > div:first-child {
    padding-left: 0;
  }

  .figures > div:last-child {
    border-right: 0;
  }

  .figures dd.display {
    order: -1;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 1;
    white-space: nowrap;
  }

  /* Each figure links to the case study behind it; the link covers the cell. */
  .figure-cell {
    position: relative;
  }

  .fig-source {
    margin-top: auto;
    font-size: var(--type-mono-s);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .fig-link {
    color: var(--accent);
    text-decoration: none;
  }

  .fig-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (hover: hover) {
    .figure-cell:has(.fig-link:hover) .fig-link {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .fig-link:focus-visible {
    outline: none;
  }

  .figure-cell:has(.fig-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .list {
    margin-top: -8px;
  }

  .principles {
    padding: 0;
    list-style: none;
  }

  .proof-kicker {
    margin: 0;
    padding: 4px 0 8px;
  }

  .proof-account {
    color: var(--ink);
    text-underline-offset: 3px;
    text-transform: none;
    letter-spacing: 0;
  }

  .repos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proof-part + .proof-part {
    margin-top: 32px;
  }

  .quotes {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 8px;
  }

  .all-recs {
    margin-top: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .all-recs a {
    color: var(--ink);
  }

  .repo {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    grid-template-areas: 'name line' 'name meta';
    gap: 4px 20px;
    align-items: baseline;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
  }

  .repo-name {
    grid-area: name;
    margin: 0;
    font-size: 24px;
  }

  .repo-name a {
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .repo-line {
    grid-area: line;
    max-width: 40em;
    font-size: 18px;
    line-height: 1.45;
  }

  .repo-meta {
    grid-area: meta;
    font-size: 12px;
  }

  /* Principles at pull-quote scale: each one a statement, not a list item. */
  .principle {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--rule);
  }

  .principle-title {
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.02;
    max-width: 22ch;
  }

  .principle p {
    margin-top: var(--space-4);
    font-size: var(--type-body-l);
    line-height: 1.5;
    max-width: 36em;
  }

  .more {
    display: inline-block;
    margin-top: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role {
    scroll-margin-top: 80px;
    display: grid;
    grid-template-columns: 96px 150px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .role-org {
    font-size: 15px;
    font-weight: 600;
  }

  .role p {
    font-size: 18px;
    line-height: 1.45;
  }

  .role-title {
    font-weight: 600;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding: 16px 0 24px;
  }

  /* Wide screens: email and profiles beside the form instead of an empty half. */
  @media (min-width: 1100px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr);
      gap: 48px;
    }

    .contact-side {
      padding-top: 8px;
    }
  }

  /* The closing statement: the page's last word, set near the headline's scale. */
  .ask {
    font-size: clamp(40px, 6.4vw, 80px);
    line-height: 0.98;
    max-width: 14ch;
  }

  .ask-sub {
    margin-top: var(--space-5);
    max-width: 36em;
    font-size: var(--type-body-l);
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 8px;
    }

    .figures {
      margin-top: 0;
    }

    .figures > div {
      padding: 18px 16px 18px 0;
    }

    .figures > div + div {
      padding-left: 16px;
    }

    .role {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 6px 14px;
    }

    .role p {
      grid-column: 1 / -1;
      font-size: 17px;
    }

    .repo {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'name' 'line' 'meta';
    }

  }

  /* Narrow phones: the two hero buttons share the row equally. */
  @media (max-width: 480px) {
    .actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .action {
      justify-content: center;
      padding: 0 8px;
    }
  }

  @media (max-width: 640px) {
    .figures {
      grid-template-columns: minmax(0, 1fr);
    }

    .figures > div,
    .figures > div + div {
      padding: 16px 0;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .figures > div:last-child {
      border-bottom: 0;
    }

    .principle {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding: var(--space-7) 0;
    }

    .principle-title {
      font-size: 28px;
    }
  }
</style>
