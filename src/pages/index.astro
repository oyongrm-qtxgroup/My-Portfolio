---
import Base from '../layouts/Base.astro';
import MarginRow from '../components/MarginRow.astro';
import WorkRow from '../components/WorkRow.astro';
import ContactForm from '../components/ContactForm.astro';
import Years from '../components/Years.astro';
import { getPrinciples, getProfile, getRoles, getSkills, getWork } from '../lib/content';

const [profile, skills, principles, work, roles] = await Promise.all([
  getProfile(),
  getSkills(),
  getPrinciples(),
  getWork(),
  getRoles(),
]);

// Work first (docs/FIX_PLAN.md D4): the projects are the evidence, so they come before
// the capabilities they prove. Each capability links to the project behind its proof.
const workById = new Map(work.map((w) => [w.id, w]));
const projectFor = (proof: { work?: { id: string } }[]) =>
  proof.map((p) => p.work && workById.get(p.work.id)).find(Boolean);

// schema.org Person for search engines: who, what, where, and the profiles that confirm it.
const currentRole = roles.find((r) => r.data.current);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  description: profile.summary,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  image: new URL('/og/home.png', Astro.site).href,
  address: { '@type': 'PostalAddress', addressCountry: 'PH' },
  ...(currentRole && { worksFor: { '@type': 'Organization', name: currentRole.data.org } }),
  knowsAbout: skills.map((s) => s.data.name),
  sameAs: [profile.links.linkedin, profile.links.github],
};
---

<Base description={profile.summary} jsonLd={person}>
  <MarginRow index={0} hideLabel headed>
    <Fragment slot="label">Intro</Fragment>
    <div class="hero">
      <h1 class="display headline">
        {/* The space keeps the words apart for screen readers and the phone layout below. */}
        {profile.headline.map((line, i) => (
          <Fragment>
            <span class="ln" style={`--i: ${i}`}>{line}</span>{' '}
          </Fragment>
        ))}
      </h1>
      <p class="identity">
        <span class="identity-name">{profile.name}</span>
        <span class="identity-title">{profile.title}</span>
      </p>
      <p class="actions">
        <a href="/raymundo-oyong-cv.pdf" class="action primary" download>Download CV</a>
        <a href="#work" class="action">Selected work</a>
      </p>
      <!-- Not faded: the largest text block on a phone must paint at once (LCP). -->
      <p class="lede">{profile.lede}</p>
      <p class="availability">{profile.availability}</p>
      <p class="mono muted where">
        {profile.location} · <a href={`mailto:${profile.email}`} class="accent">{profile.email}</a>
      </p>
    </div>
  </MarginRow>

  <MarginRow index={1}>
    <Fragment slot="label">In <br />figures</Fragment>
    <dl class="figures fade" style="--i: 4">
      {
        profile.figures.map((f) => (
          <div>
            <dt class="fig-label">{f.label}</dt>
            <dd class="display tabular">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </MarginRow>

  <MarginRow index={2} ruled id="work" hideLabel>
    <Fragment slot="label">Selected <br />work<span class="phone-only"> · {work.length}</span></Fragment>
    <h2 class="visually-hidden">Selected work</h2>
    <div class="list">
      {work.map((w, i) => <WorkRow work={w} index={i} />)}
    </div>
  </MarginRow>

  <MarginRow index={3} ruled id="experience" hideLabel>
    <Fragment slot="label">Experience</Fragment>
    <h2 class="visually-hidden">Experience</h2>
    <div class="list">
      {
        roles.map((r) => (
          <div class="role reveal">
            <Years start={r.data.start} end={r.data.end} class="mono muted" />
            <span class="role-org">{r.data.short}</span>
            <p>
              <strong class="role-title">{r.data.title}.</strong> {r.data.summary}
            </p>
          </div>
        ))
      }
    </div>
    <a href="/cv/" class="mono accent more target">Full CV →</a>
  </MarginRow>

  <MarginRow index={4} ruled id="capabilities" hideLabel>
    <Fragment slot="label">Capabilities</Fragment>
    <h2 class="visually-hidden">Capabilities</h2>
    <dl class="caps">
      {
        skills.map((s) => {
          const project = projectFor(s.data.proof);
          return (
            <div class="cap reveal" id={s.id}>
              <dt class="title cap-name">{s.data.name}</dt>
              <dd class="cap-line">
                {s.data.summary}
                {project && (
                  <>
                    {' '}
                    <a href={`/work/${project.id}/`} class="cap-link">
                      {project.data.title} →
                    </a>
                  </>
                )}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </MarginRow>

  <MarginRow index={5} ruled id="principles" hideLabel>
    <Fragment slot="label">Principles</Fragment>
    <h2 class="visually-hidden">Principles</h2>
    <ol class="list principles">
      {
        principles.map((p, i) => (
          <li class="principle reveal">
            <span class="mono muted tabular">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="title principle-title">{p.data.title}</h3>
              <p>{p.data.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </MarginRow>

  <MarginRow index={6} ruled id="contact" hideLabel headed>
    <Fragment slot="label">Contact</Fragment>
    <div class="contact reveal">
      <div class="contact-main">
        <h2 class="display ask">Hiring for a role? Tell me about it.</h2>
        <p class="ask-sub">Email is the fastest way to reach me. Project enquiries are welcome too.</p>
        <ContactForm email={profile.email} />
      </div>
      <div class="contact-side">
        <a href={`mailto:${profile.email}`} class="accent email">{profile.email}</a>
        <ul class="mono links">
          <li><a href={profile.links.linkedin} class="target">LinkedIn</a></li>
          <li><a href={profile.links.github} class="target">GitHub</a></li>
          <li><a href="/raymundo-oyong-cv.pdf" class="target" download>CV (PDF)</a></li>
        </ul>
      </div>
    </div>
  </MarginRow>
</Base>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 16px;
  }

  .headline {
    font-size: clamp(44px, 7.4vw, 92px);
    max-width: 20ch;
  }

  .identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    margin-top: 28px;
    font-family: var(--font-display);
    font-stretch: 80%;
    line-height: 1.1;
  }

  .identity-name {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
  }

  .identity-title {
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 500;
    color: var(--ink-2);
  }

  .lede {
    margin-top: 28px;
  }

  .availability {
    margin-top: 16px;
    max-width: 40em;
    font-size: 18px;
    line-height: 1.5;
  }

  .where {
    margin-top: 20px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--ink);
    color: var(--ink);
    font: 500 13px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .action.primary {
    background: var(--ink);
    color: var(--paper);
  }

  /* Buttons invert ink and paper; blue is for text links only (FIX_PLAN D12). */
  @media (hover: hover) {
    .action:hover {
      background: var(--ink);
      color: var(--paper);
    }

    .action.primary:hover {
      background: var(--paper);
      color: var(--ink);
    }
  }

  .action:active {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .action.primary:active {
    outline: 2px solid var(--paper);
    outline-offset: -2px;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: -28px 0 0;
  }

  /* Stat labels in sentence case: they're facts people scan, not metadata. */
  .fig-label {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .figures > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 20px 32px;
    border-right: 1px solid var(--rule);
  }

  .figures > div:first-child {
    padding-left: 0;
  }

  .figures > div:last-child {
    border-right: 0;
  }

  .figures dd {
    order: -1;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 1;
    white-space: nowrap;
  }

  .list {
    margin-top: -8px;
  }

  .caps {
    margin: -8px 0 0;
  }

  .cap {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .cap:last-child {
    border-bottom: 0;
  }

  .cap-name {
    font-size: 24px;
  }

  .cap-line {
    margin: 0;
    max-width: 40em;
    font-size: 18px;
    line-height: 1.45;
  }

  .cap-link {
    white-space: nowrap;
    color: var(--accent);
  }

  .principles {
    padding: 0;
    list-style: none;
  }

  .principle {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
  }

  .principle-title {
    font-size: 28px;
  }

  .principle p {
    margin-top: 8px;
    font-size: 18px;
    line-height: 1.5;
    max-width: 40em;
  }

  .more {
    display: inline-block;
    margin-top: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role {
    display: grid;
    grid-template-columns: 96px 150px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .role-org {
    font-size: 15px;
    font-weight: 600;
  }

  .role p {
    font-size: 18px;
    line-height: 1.45;
  }

  .role-title {
    font-weight: 600;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding: 16px 0 24px;
  }

  /* Wide screens: email and profiles beside the form instead of an empty half. */
  @media (min-width: 1100px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr);
      gap: 48px;
    }

    .contact-side {
      padding-top: 8px;
    }
  }

  .ask {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
    max-width: 18ch;
  }

  .ask-sub {
    margin-top: 16px;
    max-width: 36em;
  }

  .email {
    display: inline-block;
    font-size: clamp(22px, 3vw, 30px);
    text-underline-offset: 6px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 8px;
    }

    .figures {
      margin-top: 0;
    }

    .figures > div {
      padding: 18px 16px 18px 0;
    }

    .figures > div + div {
      padding-left: 16px;
    }

    .role {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 6px 14px;
    }

    .role p {
      grid-column: 1 / -1;
      font-size: 17px;
    }

    .cap {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }

    .cap-line {
      font-size: 17px;
    }
  }

  /* Narrow phones: the two hero buttons share the row equally. */
  @media (max-width: 480px) {
    .actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .action {
      justify-content: center;
      padding: 0 8px;
    }
  }

  @media (max-width: 640px) {
    .figures {
      grid-template-columns: minmax(0, 1fr);
    }

    .figures > div,
    .figures > div + div {
      padding: 16px 0;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .figures > div:last-child {
      border-bottom: 0;
    }

    .principle {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }

    .principle-title {
      font-size: 24px;
    }
  }
</style>
