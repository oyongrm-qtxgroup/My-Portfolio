---
import Base from '../layouts/Base.astro';
import MarginRow from '../components/MarginRow.astro';
---

<Base title="Page not found — Raymundo Oyong" noindex>
  <MarginRow>
    <Fragment slot="label">404<br />Not found</Fragment>
    <div class="missing">
      <h1 class="display">Page not found.</h1>
      <div class="text">
        <p>
          There’s no page at <code class="mono" id="missing-path">this address</code>. These are
          the places most links lead to:
        </p>
        <ul class="mono exits">
          <li><a href="/#work" class="accent target">Selected work →</a></li>
          <li><a href="/cv/" class="accent target">CV →</a></li>
          <li><a href="/#contact" class="accent target">Contact →</a></li>
        </ul>
      </div>
    </div>
  </MarginRow>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('missing-path');
    if (el) el.textContent = location.pathname;
  });
</script>

<style>
  .missing {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 24px 48px;
    padding: 40px 0 80px;
  }

  h1 {
    font-size: clamp(64px, 10vw, 120px);
    line-height: 0.9;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 30em;
    font-size: 19px;
  }

  .exits {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .exits a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
