---
import Base from '../layouts/Base.astro';
import MarginRow from '../components/MarginRow.astro';
import Stamp from '../components/Stamp.astro';
import WorkRow from '../components/WorkRow.astro';
import { getWork } from '../lib/content';

const work = await getWork();
---

<Base title="Page not found — Raymundo Oyong" noindex>
  <MarginRow>
    <Fragment slot="label">404 <br />Not found</Fragment>
    <div class="missing">
      <div class="head">
        <h1 class="display">Page not found.</h1>
        <!-- Pressed beside the heading once; static under reduced motion. -->
        <span class="no-entry"><Stamp status="no-entry" /></span>
      </div>
      <p class="text">
        There’s no page at <code class="mono" id="missing-path">this address</code>. The work is
        where most links lead:
      </p>
    </div>
  </MarginRow>
  <MarginRow ruled hideLabel>
    <Fragment slot="label">Selected <br />work</Fragment>
    <h2 class="visually-hidden">Selected work</h2>
    <div class="list">
      {work.map((w, i) => <WorkRow work={w} index={i} />)}
    </div>
  </MarginRow>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('missing-path');
    if (el) el.textContent = location.pathname;
  });
</script>

<style>
  .missing {
    padding: var(--space-8) 0 48px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }

  h1 {
    font-size: var(--type-display-l);
    line-height: 0.9;
  }

  .no-entry :global(.stamp) {
    padding: var(--space-2) var(--space-4);
    font-size: var(--type-body);
  }

  .text {
    margin-top: var(--space-7);
    max-width: 30em;
    font-size: var(--type-body-m);
  }

  .list {
    margin-top: -8px;
  }
</style>
