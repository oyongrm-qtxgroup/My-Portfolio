---
// Share-image source: a 1200×630 card per public page, screenshotted to
// public/og/<slug>.png by `npm run og`. Not linked, not in the sitemap, noindex.
import { palettes } from '../../design/tokens';
import { getPublicPages, type PublicPage } from '../../lib/pages';
import { ALT, src } from '../../lib/portrait';
import '../../styles/fonts.css';

export async function getStaticPaths() {
  return (await getPublicPages()).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: PublicPage;
}

const { page } = Astro.props;
const t = palettes.paper;
const long = page.title.length > 40;
// define:vars emits nothing on an is:inline style, so write the palette out directly.
const vars = `:root{--paper:${t.paper};--ink:${t.ink};--ink2:${t.ink2};--rule:${t.rule};--accent:${t.accent};--margin:${t.margin}}`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Share image: {page.title}</title>
    <style is:inline set:html={vars} />
    <style is:inline>
      html,
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
      }
      .card {
        position: relative;
        width: 1200px;
        height: 630px;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: 200px 1fr;
        overflow: hidden;
      }
      .card::before {
        content: '';
        position: absolute;
        left: 200px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--margin);
      }
      .mar {
        padding: 48px 24px 0 56px;
        font-family: 'Archivo Variable', sans-serif;
        font-stretch: 72%;
        font-weight: 700;
        font-size: 64px;
        line-height: 1;
        color: var(--ink);
      }
      .mar.portrait {
        padding: 56px 24px 0 44px;
      }
      .mar.portrait img {
        display: block;
        width: 132px;
        height: 132px;
      }
      .who {
        font-family: 'Archivo Variable', sans-serif;
        font-stretch: 78%;
        font-weight: 700;
        font-size: 56px;
        line-height: 1;
        color: var(--ink);
      }
      .body {
        display: flex;
        flex-direction: column;
        padding: 56px 72px 56px 56px;
      }
      .kicker {
        margin-top: 12px;
        font: 500 22px/1.4 'IBM Plex Mono', monospace;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--ink2);
      }
      h1 {
        margin: 24px 0 0;
        font-family: 'Archivo Variable', sans-serif;
        font-stretch: 72%;
        font-weight: 700;
        line-height: 0.95;
        letter-spacing: -0.01em;
        font-size: 104px;
        text-wrap: balance;
      }
      h1.long {
        font-size: 72px;
      }
      .line {
        margin: 20px 0 0;
        max-width: 28em;
        font: 28px/1.35 'Source Serif 4 Variable', Georgia, serif;
      }
      .stack {
        margin: 16px 0 0;
        font: 500 20px/1.4 'IBM Plex Mono', monospace;
        color: var(--ink2);
      }
      .foot {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-top: 20px;
        border-top: 2px solid var(--ink);
        gap: 24px;
        font: 500 18px 'IBM Plex Mono', monospace;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }
      .foot .site {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <div class="card">
      {
        page.slug === 'home' ? (
          <div class="mar portrait">
            <img src={src('paper', 'face', 264, 'webp')} alt={ALT} width="132" height="132" />
          </div>
        ) : (
          <div class="mar" aria-hidden="true">
            RO
          </div>
        )
      }
      <div class="body">
        <div class="who">Raymundo Oyong</div>
        <div class="kicker">{page.kicker}</div>
        <h1 class:list={{ long }}>{page.title}</h1>
        {page.line && <p class="line">{page.line}</p>}
        {page.stack && <p class="stack">{page.stack}</p>}
        <div class="foot">
          <span>Based in the Philippines · working with QTX, Sydney</span>
          <span class="site">raymundo-oyong.vercel.app</span>
        </div>
      </div>
    </div>
  </body>
</html>
