---
// The CV, generated from the same content as the site. Follows the Harvard
// Extension School OCS guide (docs/REDESIGN_PLAN.md §7): no "I", reverse
// chronological, email only. On screen it sits in the logbook frame; in print
// it becomes the A4 sheet from docs/design/CVPage1/2.
import Base from '../layouts/Base.astro';
import MarginRow from '../components/MarginRow.astro';
import Timeline from '../components/Timeline.astro';
import { getRepos, pushedOn } from '../lib/github';
import { getProfile, getRoles, type Role } from '../lib/content';

const [profile, roles, repos] = await Promise.all([getProfile(), getRoles(), getRepos()]);
const cv = profile.cv;

// Consecutive roles at the same organisation share one heading (as on the design).
const orgs: { org: string; place: string; roles: Role[] }[] = [];
for (const r of roles) {
  const last = orgs.at(-1);
  if (last && last.org === r.data.org) last.roles.push(r);
  else orgs.push({ org: r.data.org, place: r.data.place, roles: [r] });
}

const linkText = (url: string) => url.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '');
// Absolute, so the links in the PDF point to the live site, not the local build server.
const siteUrl = new URL('/', Astro.site).href;
// Split text so hyphenated compounds ("retrieval-augmented") never break at a line
// end: PDF text extraction drops the hyphen there and fuses the two words.
const keepCompounds = (text: string) => text.split(/(\S+-\S+)/);
---

<Base
  title={`CV — ${profile.name}`}
  description={`CV of ${profile.name}, ${profile.title}: experience, skills, education and certifications.`}
>
  <article class="cv">
    <MarginRow index={0}>
      <Fragment slot="label">Curriculum <br />vitae</Fragment>
      <header class="cv-head">
        <h1 class="display cv-name">{cv.name}</h1>
        <p class="title cv-title">{cv.title}</p>
        <p class="cv-contact">
          {cv.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a> ·{' '}
          <a href={profile.links.linkedin}>{linkText(profile.links.linkedin)}</a> ·{' '}
          <a href={profile.links.github}>{linkText(profile.links.github)}</a> ·{' '}
          <a href={siteUrl}>{cv.site}</a>
        </p>
        <p class="cv-availability">{profile.availability}</p>
        <p class="cv-pdf">
          <a href="/raymundo-oyong-cv.pdf" class="mono accent target" download>
            Download the PDF (A4, 2 pages) →
          </a>
        </p>
        <!-- On screen only, like the portrait: the PDF keeps its Harvard layout. -->
        <Timeline roles={roles} now={profile.updated} class="cv-timeline" />
      </header>
    </MarginRow>

    <MarginRow index={1} ruled>
      <Fragment slot="label">Summary</Fragment>
      <h2 class="cv-h2">Summary</h2>
      <p class="cv-summary">{profile.summary}</p>
    </MarginRow>

    <MarginRow index={2} ruled>
      <Fragment slot="label">Professional <br />experience</Fragment>
      <h2 class="cv-h2">Professional Experience</h2>
      {
        orgs.map((o) => (
          <section class="cv-org-block">
            <h3 class="cv-line">
              <span class="cv-org">{o.org}</span>
              <span class="cv-meta"> · {o.place}</span>
            </h3>
            {o.roles.map((r) => (
              <div class="cv-role">
                <p class="cv-line">
                  <span class="cv-role-title">{r.data.title}</span>
                  <span class="cv-meta">
                    {' '}
                    · {r.data.start} – {r.data.end ?? 'Present'}
                  </span>
                </p>
                {r.data.projects.map((p) => (
                  <ul class="cv-ul cv-project">
                    {p.bullets.map((b, i) => (
                      <li data-cv-bullet>
                        {i === 0 && <strong class="cv-lead">{p.heading}. </strong>}
                        <span data-cv-text>
                          {keepCompounds(b).map((t, k) => (k % 2 ? <span class="nowrap">{t}</span> : t))}
                        </span>
                      </li>
                    ))}
                  </ul>
                ))}
                {r.data.highlights.length > 0 && (
                  <ul class="cv-ul">
                    {r.data.highlights.map((b) => (
                      <li data-cv-bullet>
                        <span data-cv-text>
                          {keepCompounds(b).map((t, k) => (k % 2 ? <span class="nowrap">{t}</span> : t))}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>
        ))
      }
      {
        repos.length > 0 && (
          <p class="mono muted cv-code">
            Code on GitHub:{' '}
            {repos.map((r, i) => (
              <>
                {i > 0 && ' · '}
                <a href={r.url}>{r.name}</a> ({[r.language, pushedOn(r.pushed).toLowerCase()].filter(Boolean).join(', ')})
              </>
            ))}
          </p>
        )
      }
    </MarginRow>

    <MarginRow index={3} ruled>
      <Fragment slot="label">Technical <br />skills</Fragment>
      <h2 class="cv-h2">Technical Skills</h2>
      <dl class="cv-skills">
        {
          cv.skills.map((s) => (
            <div>
              <dt>{s.label}:</dt>
              <dd>
                {keepCompounds(s.items).map((t, i) => (i % 2 ? <span class="nowrap">{t}</span> : t))}
              </dd>
            </div>
          ))
        }
      </dl>
    </MarginRow>

    <MarginRow index={4} ruled>
      <Fragment slot="label">Education</Fragment>
      <h2 class="cv-h2">Education</h2>
      {
        cv.education.map((e) => (
          <section class="cv-org-block">
            <h3 class="cv-line">
              <span class="cv-org">{e.school}</span>
              <span class="cv-meta"> · {e.place}</span>
            </h3>
            <p class="cv-line cv-role">
              <span class="cv-role-title">{e.degree}</span>
              <span class="cv-meta"> · {e.year}</span>
            </p>
            {e.notes.length > 0 && (
              <ul class="cv-ul">
                {e.notes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </MarginRow>

    <MarginRow index={5} ruled>
      <Fragment slot="label">Certifications</Fragment>
      <h2 class="cv-h2">Certifications</h2>
      {
        cv.certifications.map((c) => (
          <p class="cv-line cv-cert">
            <span class="cv-cert-name">{c.name}</span>
            <span class="cv-meta"> · {c.date}</span>
            {c.url && (
              <span class="cv-meta">
                {' '}
                · <a href={c.url}>Verify credential</a>
              </span>
            )}
          </p>
        ))
      }
      <p class="cv-more">
        Skills, project pages and working principles: <a href={siteUrl}>{cv.site}</a>
      </p>
    </MarginRow>
    <!-- Wide screens: the download stays in reach in the margin while reading (M-06). -->
    <p class="cv-sticky">
      <a href="/raymundo-oyong-cv.pdf" class="mono accent target" download>Download the PDF ↓</a>
    </p>
  </article>
</Base>

<style>
  /* Screen only: the PDF lists experience, not repositories. */
  .cv-code {
    padding: var(--space-1) 0 var(--space-5);
    line-height: 1.6;
  }

  .cv-code a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  .cv-head {
    position: relative;
    padding: var(--space-7) 0 var(--space-5);
  }

  .cv-name {
    font-size: var(--type-display-m);
  }

  .cv-title {
    margin-top: var(--space-2);
    font-size: var(--type-lead-fluid);
    font-stretch: 85%;
    font-weight: 500;
  }

  .cv-contact {
    margin-top: var(--space-4);
    font: var(--type-mono)/1.6 var(--font-mono);
    color: var(--ink-2);
  }

  /* A link never breaks at its own hyphen ("raymundo-" / "oyong.vercel.app"). */
  .cv-contact a {
    color: inherit;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  .cv-availability {
    margin-top: var(--space-3);
    max-width: 44em;
    font-size: var(--type-ui);
    line-height: 1.5;
  }

  .cv-pdf {
    margin-top: var(--space-5);
    font-size: var(--type-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cv-head :global(.cv-timeline) {
    margin-top: var(--space-6);
    border-top: var(--rule-hair) solid var(--rule);
  }

  /* Pinned to the bottom of the margin column for as long as the CV is on screen;
     a zero-height box, so it adds no space at the end of the page. */
  .cv-sticky {
    display: none;
  }

  @media (min-width: 901px) {
    .cv-sticky {
      display: block;
      position: sticky;
      bottom: var(--space-6);
      height: 0;
      margin: 0;
    }

    .cv-sticky a {
      position: absolute;
      bottom: 0;
      left: 0;
      width: calc(var(--margin-col) - var(--space-6));
      padding: var(--space-2) 0;
      background: var(--paper);
      border-top: var(--rule-firm) solid var(--ink);
      font-size: var(--type-mono-s);
      line-height: 1.4;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
  }

  /* The closing pointer to the site is for paper only. */
  .cv-more {
    display: none;
  }

  /* On screen the margin label names each section; the heading is for print. */
  .cv-h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cv-summary {
    padding: var(--space-6) 0;
    font-size: var(--type-body-m);
    line-height: 1.55;
    max-width: 40em;
  }

  .cv-org-block {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--rule);
  }

  .cv-org-block:last-child {
    border-bottom: 0;
  }

  /* One-line headers. The organisation line is an h3: reset its heading font so
     only .cv-org is set large and the place reads as secondary. */
  .cv-line {
    margin: 0;
    font: inherit;
  }

  .cv-org {
    font-family: var(--font-display);
    font-stretch: 78%;
    font-weight: 700;
    font-size: var(--type-title-m);
    line-height: 1.1;
  }

  .cv-meta {
    font: var(--type-small)/1.5 var(--font-body);
    color: var(--ink-2);
  }

  .cv-role {
    margin-top: var(--space-4);
  }

  .cv-role-title {
    font: 600 var(--type-body)/1.4 var(--font-body);
  }

  .cv-project + .cv-project {
    margin-top: var(--space-3);
  }

  .cv-lead {
    font-weight: 600;
  }

  .nowrap {
    white-space: nowrap;
  }

  .cv-ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 46em;
    font-size: var(--type-body-s);
    line-height: 1.5;
  }

  .cv-skills {
    margin: 0;
    padding: var(--space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--type-body-s);
    line-height: 1.5;
  }

  .cv-skills dt {
    display: inline;
    font-weight: 600;
  }

  .cv-skills dd {
    display: inline;
    margin: 0 0 0 var(--space-1);
  }

  .cv-cert {
    padding: var(--space-6) 0;
  }

  .cv-cert-name {
    font: var(--type-body-s)/1.5 var(--font-body);
  }

  /* ── Print: the A4 sheet (docs/design/CVPage1/2) ── */
  @media print {
    @page {
      size: A4;
      margin: 12mm 15mm 10mm;
    }

    :global(html),
    :global(body) {
      background: #fff !important;
      color: #141413 !important;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip),
    .cv :global(.mar) {
      display: none !important;
    }

    :global(.wrap) {
      max-width: none;
      padding: 0;
    }

    .cv :global(.row) {
      display: block;
      border: 0 !important;
    }

    .cv :global(.row > .body) {
      padding: 0;
    }

    .cv {
      border-top: 4px solid #c8322a;
      padding-top: 7mm;
      font: 10pt/1.38 var(--font-body);
    }

    .cv a {
      color: inherit;
      text-decoration: none;
    }

    .cv-head {
      padding: 0 0 8pt;
    }

    .cv-head :global(.cv-timeline),
    .cv-sticky,
    .cv-code {
      display: none !important;
    }

    .cv-pdf {
      display: none;
    }

    .cv-more {
      display: block;
      margin-top: 14pt;
      padding-top: 5pt;
      border-top: 1px solid #d8d8d2;
      font-size: 9pt;
      color: #3e3e39;
    }

    .cv-name {
      font-size: 28pt;
      line-height: 1;
    }

    .cv-title {
      margin-top: 3pt;
      font-size: 11.5pt;
    }

    .cv-contact {
      margin-top: 6pt;
      font: 9.4pt/1.4 var(--font-body);
      color: #3e3e39;
    }

    .cv-availability {
      max-width: none;
      margin-top: 3pt;
      font: 9.4pt/1.4 var(--font-body);
    }

    .cv-h2 {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      margin: 12pt 0 6pt;
      padding-bottom: 3pt;
      border-bottom: 1px solid #141413;
      font-family: var(--font-display);
      font-stretch: 80%;
      font-weight: 700;
      font-size: 11pt;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      break-after: avoid;
    }

    .cv-summary,
    .cv-skills,
    .cv-cert,
    .cv-org-block {
      max-width: none;
      padding: 0;
      border: 0;
      font-size: 10pt;
      line-height: 1.38;
    }

    .cv-org-block + .cv-org-block {
      margin-top: 8pt;
    }

    .cv-line {
      break-after: avoid;
    }

    .cv-org {
      font: 400 10pt/1.38 var(--font-body);
      letter-spacing: 0.02em;
    }

    .cv-meta,
    .cv-cert-name {
      font: inherit;
      color: #3e3e39;
    }

    .cv-cert-name {
      color: inherit;
    }

    .cv-role-title {
      font: 600 10pt/1.38 var(--font-body);
    }

    .cv-role {
      margin-top: 2pt;
    }

    .cv-role + .cv-role {
      margin-top: 4pt;
    }

    .cv-project {
      break-inside: avoid;
    }

    .cv-project + .cv-project {
      margin-top: 3pt;
    }

    .cv-ul {
      margin: 1pt 0 0;
      padding-left: 14pt;
      gap: 1.5pt;
      max-width: none;
      font-size: 10pt;
      line-height: 1.38;
    }

    .cv-ul li {
      break-inside: avoid;
    }

    .cv-skills {
      gap: 2pt;
    }
  }
</style>
