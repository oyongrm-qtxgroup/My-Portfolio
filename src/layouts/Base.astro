---
import { ClientRouter } from 'astro:transitions';
import archivoLatin from '../assets/fonts/archivo-subset.woff2?url';
import serifLatin from '../assets/fonts/source-serif-4-subset.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { tokensCss } from '../design/tokens';
import { ogImageFor } from '../lib/pages';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Structured data (schema.org) for this page, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'Raymundo Oyong — AI and automation engineer',
  description = 'Raymundo Oyong builds AI and software that does the work people shouldn\'t have to: voice agents, document AI with sources, and process automation.',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(await ogImageFor(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raymundo Oyong" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F6F6F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131412" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={tokensCss} />
    <script is:inline>
      // Applies the saved theme before first paint. 'auto' follows the OS.
      (() => {
        if (window.__themeBoot) return;
        window.__themeBoot = true;
        const media = matchMedia('(prefers-color-scheme: dark)');
        const apply = () => {
          let choice;
          try {
            choice = localStorage.getItem('theme');
          } catch {}
          if (choice !== 'paper' && choice !== 'night') choice = 'auto';
          const night = choice === 'night' || (choice === 'auto' && media.matches);
          const root = document.documentElement;
          root.dataset.theme = night ? 'night' : 'paper';
          root.dataset.themeChoice = choice;
        };
        apply();
        media.addEventListener('change', apply);
        document.addEventListener('theme:change', apply);
        document.addEventListener('astro:after-swap', apply);
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.documentElement.classList.add('theme-ready')),
        );
        document.addEventListener('astro:after-swap', () =>
          document.documentElement.classList.add('theme-ready'),
        );
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <span class="ink-progress" aria-hidden="true" transition:persist="ink-progress"></span>
    <span class="page-edge" aria-hidden="true"></span>
    <div class="wrap">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      // An ink line at the top, only when a page change takes longer than 150 ms.
      let timer: ReturnType<typeof setTimeout> | undefined;
      const bar = () => document.querySelector('.ink-progress');
      document.addEventListener('astro:before-preparation', () => {
        clearTimeout(timer);
        timer = setTimeout(() => bar()?.classList.add('on'), 150);
      });
      document.addEventListener('astro:after-swap', () => {
        clearTimeout(timer);
        bar()?.classList.remove('on');
      });
    </script>
  </body>
</html>
