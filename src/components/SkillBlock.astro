---
// One lead skill on the home page: what I can do for the reader, then the proof,
// with links to the project pages the proof comes from.
import { getEntry } from 'astro:content';
import type { Skill } from '../lib/content';

interface Props {
  skill: Skill;
  no: number;
}

const { skill, no } = Astro.props;
const s = skill.data;
const workIds = [...new Set(s.proof.flatMap((p) => (p.work ? [p.work.id] : [])))];
const pages = await Promise.all(workIds.map((id) => getEntry('work', id)));
---

<section class="skill reveal" id={skill.id} aria-labelledby={`${skill.id}-name`}>
  <span class="mono muted tabular no">{String(no).padStart(2, '0')}</span>
  <div>
    <h3 class="title name" id={`${skill.id}-name`}>{s.name}</h3>
    <p class="pitch">{s.pitch}</p>
    <h4 class="label proof-label">Proof</h4>
    <ul class="proof">
      {s.proof.map((p) => <li>{p.text}</li>)}
    </ul>
    {
      pages.map(
        (w) =>
          w && (
            <a href={`/work/${w.id}/`} class="mono accent page target">
              Project: {w.data.title} →
            </a>
          ),
      )
    }
  </div>
</section>

<style>
  .skill {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 32px 0;
    border-bottom: 1px solid var(--rule);
  }

  .skill:last-child {
    border-bottom: 0;
  }

  .name {
    font-size: clamp(32px, 4vw, 44px);
  }

  .pitch {
    margin-top: 14px;
    font-size: 20px;
    line-height: 1.5;
    max-width: 36em;
  }

  .proof-label {
    margin-top: 22px;
  }

  .proof {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 40em;
    font-size: 17px;
    line-height: 1.45;
  }

  .proof li {
    padding-left: 18px;
    text-indent: -18px;
  }

  .proof li::before {
    content: '— ';
    color: var(--accent);
  }

  .page {
    display: inline-block;
    margin-top: 18px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .skill {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding: 24px 0;
    }

    .pitch {
      font-size: 18px;
    }
  }
</style>
