---
import Stamp from './Stamp.astro';
import StackList from './StackList.astro';
import type { Work } from '../lib/content';

interface Props {
  work: Work;
  index: number;
}

const { work, index } = Astro.props;
const w = work.data;
---

<!-- The title is the link (a short name in a link list); its hit area covers the row. -->
<article class="work-row reveal">
  <span class="mono muted">No. {w.no}</span>
  <span class="main">
    <h3 class="title name">
      <a href={`/work/${work.id}/`} class="row-link"
        ><span class="ttl" transition:name={`work-${work.id}`}>{w.title}</span><span
          class="arr"
          aria-hidden="true">→</span
        ></a
      >
    </h3>
    <span class="line muted">{w.short}</span>
  </span>
  <StackList items={w.stack.slice(0, 4)} class="mono muted stack" />
  <span class="meta">
    <span class="mono muted">{w.period}</span>
    <Stamp status={w.status} index={index} />
  </span>
</article>

<style>
  .work-row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 220px 140px;
    gap: 20px;
    align-items: baseline;
    /* Even insets for the hover wash and focus ring; the text stays on the column line. */
    margin-inline: -12px;
    padding: 22px 12px;
    border-bottom: 1px solid var(--rule);
    transition: background-color 0.2s;
  }

  .row-link {
    text-decoration: none;
  }

  .row-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row-link:focus-visible {
    outline: none;
  }

  .work-row:has(.row-link:focus-visible) {
    outline: 2px solid var(--accent);
  }

  @media (hover: hover) {
    .work-row:has(.row-link:hover) {
      background: color-mix(in srgb, var(--accent) 6%, transparent);
    }
  }

  /* Touch: a press shows as an ink inset instead of a hover that sticks. */
  .work-row:has(.row-link:active) {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .name {
    margin: 0;
    font-size: 34px;
  }

  .ttl {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s;
  }

  .arr {
    display: inline-block;
    margin-left: 10px;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.2s, transform 0.2s;
  }

  .row-link:focus-visible .ttl {
    text-decoration-color: var(--accent);
  }

  .row-link:focus-visible .arr {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) {
    .row-link:hover .ttl {
      text-decoration-color: var(--accent);
    }

    .row-link:hover .arr {
      opacity: 1;
      transform: none;
    }
  }

  /* A project already read: its arrow turns quiet. */
  .row-link:visited .arr {
    color: var(--ink-2);
  }

  .line {
    font-size: 18px;
    line-height: 1.45;
    max-width: 36em;
  }

  .work-row :global(.stack) {
    font-size: 12px;
    line-height: 1.6;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .work-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 18px 12px;
    }

    .name {
      font-size: 28px;
    }

    .meta {
      flex-direction: row;
      align-items: baseline;
      gap: 16px;
    }

    .arr {
      opacity: 1;
      transform: none;
    }
  }
</style>
