---
// A left-to-right flow diagram drawn with boxes and arrows (stacks on phones).
// `key` marks the box the case study is about.
interface Step {
  title: string;
  note: string;
  key?: boolean;
  /** Arrow drawn after this step: one-way (default) or two-way. */
  link?: 'one' | 'two';
}

interface Props {
  label: string;
  caption: string;
  steps: Step[];
}

const { label, caption, steps } = Astro.props;
// '§ 1 What I built' → '§ 1' / 'What I built'; 'Fig. 1 One call' → 'Fig. 1' / 'One call'.
const [, num = label, name = ''] = label.match(/^(\S+ \S+) (.*)$/) ?? [];
---

<section class="row">
  <div class="mar label">{num}<br />{name}</div>
  <figure class="body">
    <ol class="flow" aria-label={caption}>
      {
        steps.map((s, i) => (
          <>
            <li class:list={['step', { key: s.key }]}>
              <span class="step-title">{s.title}</span>
              <span class="step-note">{s.note}</span>
            </li>
            {i < steps.length - 1 && (
              <li class="arrow" aria-hidden="true">
                {s.link === 'two' ? '⇄' : '→'}
              </li>
            )}
          </>
        ))
      }
    </ol>
    <figcaption class="mono muted caption">{num} {name} — {caption}</figcaption>
  </figure>
</section>

<style>
  .flow {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 13px/1.45 var(--font-mono);
  }

  .step {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
    border: 1.5px solid var(--ink);
  }

  .step.key {
    flex-grow: 1.3;
    border: 2px solid var(--accent);
  }

  .step-title {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .key .step-title {
    color: var(--accent);
  }

  .step-note {
    color: var(--ink-2);
  }

  .arrow {
    align-self: center;
    font-size: 20px;
  }

  .caption {
    margin-top: 14px;
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .flow {
      flex-direction: column;
    }

    .arrow {
      transform: rotate(90deg);
      line-height: 1;
    }
  }
</style>
