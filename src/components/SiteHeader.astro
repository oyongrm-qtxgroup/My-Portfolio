---
// Primary navigation. On phones (≤760 px) the links move into a disclosure menu
// (docs/design/MobileMenu): a "Menu" button with aria-expanded, Escape closes it
// and returns focus to the button. Without JS the inline links stay visible.
import ThemeSwitch from './ThemeSwitch.astro';
import ContactSet from './ContactSet.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// One name per section, in page order (docs/FIX_PLAN.md D4).
const links = [
  { href: '/#work', label: 'Work', match: '/work' },
  { href: '/#experience', label: 'Experience', match: null },
  { href: '/#capabilities', label: 'Capabilities', match: null },
  { href: '/cv/', label: 'CV', match: '/cv' },
  { href: '/#contact', label: 'Contact', match: null },
];
const current = (match: string | null) => match !== null && path.startsWith(match);
// "page" only for the page itself (/cv/); a section link (Work on a case study) is "true".
const ariaCurrent = (l: (typeof links)[number]) =>
  current(l.match) ? (l.href.replace(/\/$/, '') === path ? 'page' : 'true') : undefined;
---

<header class="site-header" data-menu-root>
  <a href="/" class="brand target">Raymundo Oyong</a>
  <nav aria-label="Primary" class="inline-nav">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="target" aria-current={ariaCurrent(l)}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <button type="button" class="menu-button" aria-expanded="false" aria-controls="phone-menu" hidden>
    Menu
  </button>
  <div id="phone-menu" class="sheet" hidden>
    <nav aria-label="Primary (menu)">
      <ul>
        {
          links.map((l, i) => (
            <li>
              <a
                href={l.href}
                class="sheet-link"
                aria-current={ariaCurrent(l)}
              >
                <span class="sheet-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="sheet-label">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <!-- The menu's foot is the same contact set as the end of each page (DESIGN_PLAN Step 12). -->
    <div class="sheet-foot">
      <ContactSet variant="menu" />
      <p class="sheet-availability">{profile.availability}</p>
      <ThemeSwitch name="menu" />
    </div>
  </div>
</header>

<script>
  // The document outlives page swaps under <ClientRouter/>: drop the previous page's listeners.
  let listeners: AbortController | undefined;

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-menu-root]');
    const button = root?.querySelector<HTMLButtonElement>('.menu-button');
    const sheet = root?.querySelector<HTMLElement>('#phone-menu');
    if (!root || !button || !sheet || root.dataset.menuReady) return;
    root.dataset.menuReady = 'true';
    root.classList.add('has-menu');
    listeners?.abort();
    listeners = new AbortController();
    const { signal } = listeners;
    button.hidden = false;

    const behind = () =>
      [document.querySelector('main'), document.querySelector('.site-footer')].filter(
        (el): el is HTMLElement => el instanceof HTMLElement,
      );

    const setOpen = (open: boolean, returnFocus = false) => {
      // The header pins to the top while open, so Close stays in reach however far the page scrolled.
      if (open) root.style.setProperty('--sheet-top', `${root.offsetHeight}px`);
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Close' : 'Menu';
      sheet.hidden = !open;
      root.classList.toggle('menu-open', open);
      document.documentElement.classList.toggle('menu-lock', open);
      behind().forEach((el) => (el.inert = open));
      if (!open && returnFocus) button.focus();
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    sheet.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') setOpen(false, true);
      },
      { signal },
    );
    // Tuck the header while reading down the page; show it again on any scroll up,
    // near the top, or when the menu or a header link takes focus.
    let lastY = scrollY;
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        const open = button.getAttribute('aria-expanded') === 'true';
        root.classList.toggle('tucked', !open && y > lastY && y > root.offsetHeight * 2);
        lastY = y;
      },
      { passive: true, signal },
    );
    root.addEventListener('focusin', () => root.classList.remove('tucked'), { signal });

    // Rotating to a wide screen closes the menu so the page is never left inert.
    matchMedia('(min-width: 761px)').addEventListener(
      'change',
      (e) => {
        if (e.matches) setOpen(false);
      },
      { signal },
    );
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .site-header {
    position: relative;
    z-index: 15;
    top: 0;
    background: var(--paper);
    transition: transform 0.25s var(--ease-out);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    padding: 10px 0;
    border-bottom: 2px solid var(--ink);
    font: 400 13px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* With JS the header is sticky: scrolling down tucks it away and any scroll up
     brings it back (docs/FIX_PLAN.md D-12). Without JS it scrolls with the page,
     since the no-JS phone header (inline links) is too tall to pin. */
  :global(html.js) .site-header {
    position: sticky;
  }

  .site-header.tucked {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  a {
    text-decoration: none;
  }

  .brand {
    font-weight: 500;
  }

  .inline-nav ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inline-nav [aria-current] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (hover: hover) {
    .inline-nav a:hover {
      text-decoration: underline;
      text-underline-offset: 5px;
    }
  }

  /* Wide enough for "Close" too, so the header doesn't move when the menu opens. */
  .menu-button {
    min-width: 76px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--ink);
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .menu-button[hidden],
  .sheet[hidden] {
    display: none;
  }

  .sheet {
    position: fixed;
    z-index: 20;
    inset: var(--sheet-top, 66px) 0 0;
    display: flex;
    flex-direction: column;
    padding: 8px var(--pad) 24px;
    background: var(--paper);
    overflow-y: auto;
    text-transform: none;
    letter-spacing: normal;
  }

  .sheet ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sheet-link {
    display: flex;
    align-items: baseline;
    gap: 16px;
    min-height: 56px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }

  .sheet-no {
    font: 12px var(--font-mono);
    color: var(--ink-2);
  }

  .sheet-label {
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 700;
    font-size: 36px;
    line-height: 1;
  }

  .sheet-link[aria-current] .sheet-label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  @media (hover: hover) {
    .sheet-link:hover .sheet-label {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
  }

  .sheet-foot {
    margin-top: auto;
    padding-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sheet-availability {
    padding-bottom: var(--space-2);
    font: 13px/1.35 var(--font-body);
    color: var(--ink-2);
  }

  /* Short phones (320 × 568): the foot stays above the fold. */
  @media (max-height: 640px) {
    .sheet {
      padding-top: var(--space-1);
      padding-bottom: var(--space-1);
    }
  }

  .sheet-foot :global(.theme-switch) {
    display: flex;
  }

  .sheet-foot :global(.seg) {
    flex: 1;
    min-height: 44px;
  }

  @media (max-width: 760px) {
    /* With JS the menu replaces the inline links. html.js is set before first paint
       (Base.astro), so the header is laid out once instead of jumping when this
       component's script runs. */
    :global(html.js) .inline-nav {
      display: none;
    }

    :global(html.js) .site-header {
      flex-wrap: nowrap;
    }

    :global(html.js) .menu-button[hidden] {
      display: block;
    }

    .inline-nav ul {
      flex-wrap: wrap;
      gap: 8px 18px;
    }

    .has-menu .inline-nav {
      display: none;
    }

    .has-menu {
      flex-wrap: nowrap;
    }

    /* Pinned while open, inset by the page gutter so nothing moves sideways. */
    .menu-open {
      position: fixed;
      z-index: 21;
      top: 0;
      left: var(--pad);
      right: var(--pad);
      background: var(--paper);
    }

    /* The gutter either side of the pinned header stays paper. */
    .menu-open::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: 0 calc(-1 * var(--pad));
      background: var(--paper);
    }
  }

  @media (min-width: 761px) {
    .menu-button,
    .sheet {
      display: none !important;
    }
  }
</style>

<style is:global>
  html.menu-lock {
    overflow: hidden;
  }
</style>
