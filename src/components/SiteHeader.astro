---
// Primary navigation. On phones (≤760 px) the links move into a disclosure menu
// (docs/design/MobileMenu): a "Menu" button with aria-expanded, Escape closes it
// and returns focus to the button. Without JS the inline links stay visible.
import ThemeSwitch from './ThemeSwitch.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/#skills', label: 'Skills', match: null },
  { href: '/#work', label: 'Work', match: '/work' },
  { href: '/cv/', label: 'CV', match: '/cv' },
  { href: '/#contact', label: 'Contact', match: null },
];
const current = (match: string | null) => match !== null && path.startsWith(match);
---

<header class="site-header" data-menu-root>
  <a href="/" class="brand target">R. Oyong — Log</a>
  <nav aria-label="Primary" class="inline-nav">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="target" aria-current={current(l.match) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <span class="vol">Vol. 2026</span>
  <button type="button" class="menu-button" aria-expanded="false" aria-controls="phone-menu" hidden>
    Menu
  </button>
  <div id="phone-menu" class="sheet" hidden>
    <nav aria-label="Primary (menu)">
      <ul>
        {
          links.map((l, i) => (
            <li>
              <a
                href={l.href}
                class="sheet-link"
                aria-current={current(l.match) ? 'page' : undefined}
              >
                <span class="sheet-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="sheet-label">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="sheet-foot">
      <a href={`mailto:${profile.email}`} class="accent sheet-email">{profile.email}</a>
      <ThemeSwitch />
    </div>
  </div>
</header>

<script>
  // The document outlives page swaps under <ClientRouter/>: drop the previous page's listeners.
  let listeners: AbortController | undefined;

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-menu-root]');
    const button = root?.querySelector<HTMLButtonElement>('.menu-button');
    const sheet = root?.querySelector<HTMLElement>('#phone-menu');
    if (!root || !button || !sheet || root.dataset.menuReady) return;
    root.dataset.menuReady = 'true';
    root.classList.add('has-menu');
    listeners?.abort();
    listeners = new AbortController();
    const { signal } = listeners;
    button.hidden = false;

    const behind = () =>
      [document.querySelector('main'), document.querySelector('.site-footer')].filter(
        (el): el is HTMLElement => el instanceof HTMLElement,
      );

    const setOpen = (open: boolean, returnFocus = false) => {
      // The header pins to the top while open, so Close stays in reach however far the page scrolled.
      if (open) root.style.setProperty('--sheet-top', `${root.offsetHeight}px`);
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Close' : 'Menu';
      sheet.hidden = !open;
      root.classList.toggle('menu-open', open);
      document.documentElement.classList.toggle('menu-lock', open);
      behind().forEach((el) => (el.inert = open));
      if (!open && returnFocus) button.focus();
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    sheet.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') setOpen(false, true);
      },
      { signal },
    );
    // Rotating to a wide screen closes the menu so the page is never left inert.
    matchMedia('(min-width: 761px)').addEventListener(
      'change',
      (e) => {
        if (e.matches) setOpen(false);
      },
      { signal },
    );
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .site-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    padding: 10px 0;
    border-bottom: 2px solid var(--ink);
    font: 400 13px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  a {
    text-decoration: none;
  }

  .brand {
    font-weight: 500;
  }

  .inline-nav ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inline-nav [aria-current='page'],
  .inline-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .vol {
    color: var(--ink-2);
  }

  .menu-button {
    min-width: 64px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--ink);
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .menu-button[hidden],
  .sheet[hidden] {
    display: none;
  }

  .sheet {
    position: fixed;
    z-index: 20;
    inset: var(--sheet-top, 66px) 0 0;
    display: flex;
    flex-direction: column;
    padding: 8px var(--pad) 24px;
    background: var(--paper);
    overflow-y: auto;
    text-transform: none;
    letter-spacing: normal;
  }

  .sheet ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sheet-link {
    display: flex;
    align-items: baseline;
    gap: 16px;
    min-height: 64px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .sheet-no {
    font: 12px var(--font-mono);
    color: var(--ink-2);
  }

  .sheet-label {
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
  }

  .sheet-link[aria-current='page'] .sheet-label,
  .sheet-link:hover .sheet-label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .sheet-foot {
    margin-top: auto;
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sheet-email {
    font: 20px var(--font-body);
    text-decoration: underline;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
  }

  .sheet-foot :global(.theme-switch) {
    display: flex;
  }

  .sheet-foot :global(.seg) {
    flex: 1;
    min-height: 44px;
  }

  @media (max-width: 760px) {
    .vol {
      display: none;
    }

    .inline-nav ul {
      flex-wrap: wrap;
      gap: 8px 18px;
    }

    .has-menu .inline-nav {
      display: none;
    }

    .has-menu {
      flex-wrap: nowrap;
    }

    .menu-open {
      position: fixed;
      z-index: 21;
      top: 0;
      left: 0;
      right: 0;
      padding-inline: var(--pad);
      background: var(--paper);
    }
  }

  @media (min-width: 761px) {
    .menu-button,
    .sheet {
      display: none !important;
    }
  }
</style>

<style is:global>
  html.menu-lock {
    overflow: hidden;
  }
</style>
