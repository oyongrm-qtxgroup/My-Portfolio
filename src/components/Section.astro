---
// A case-study section: label in the margin, prose in the middle, and optional
// margin notes on the right (inline under the text on narrow screens).
interface Props {
  label: string;
  title?: string;
  notes?: string[];
  ruled?: boolean;
}

const { label, title, notes = [], ruled = false } = Astro.props;
// '§ 1 What I built' → '§ 1' / 'What I built'; 'Fig. 1 One call' → 'Fig. 1' / 'One call'.
const [, num = label, name = ''] = label.match(/^(\S+ \S+) (.*)$/) ?? [];
---

<section class:list={['row', 'cs', { ruled }]}>
  <div class:list={['mar', 'label', { headed: !!title }]}>{num} <br />{name}</div>
  <div class="body cs-body">
    <div class="prose">
      {title ? <h2 class="title cs-title">{title}</h2> : <h2 class="visually-hidden">{name || num}</h2>}
      <slot />
    </div>
    {
      notes.length > 0 && (
        <aside class="cs-notes" aria-label="Margin notes">
          {notes.map((n) => (
            <p class="sidenote">{n}</p>
          ))}
        </aside>
      )
    }
  </div>
</section>

<style>
  .cs-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: var(--space-8);
  }

  .cs-title {
    font-size: var(--type-title);
    margin-bottom: var(--space-4);
  }

  .prose :global(h3) {
    /* "On this page" links land below the sticky header. */
    scroll-margin-top: 80px;
    font-family: var(--font-display);
    font-stretch: 78%;
    font-weight: 700;
    font-size: var(--type-title-m);
    line-height: 1.1;
    margin: var(--space-7) 0 var(--space-2);
  }

  /* The first sub-heading sits level with the label, also after a hidden h2. */
  .prose :global(:is(h3:first-child, .visually-hidden + h3, .visually-hidden + .fig-ref + h3)) {
    margin-top: 0;
  }

  /* Circled numerals (FigRef) tying a sub-heading to the figure above. */
  .prose :global(.fig-ref) {
    display: block;
    position: relative;
    height: 0;
  }

  .prose :global(.fig-ref .n) {
    position: absolute;
    top: 35px;
    left: -32px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: var(--rule-fine) solid var(--ink);
    border-radius: 50%;
    font: 500 var(--type-mono-s)/1 var(--font-mono);
  }

  .prose :global(.visually-hidden + .fig-ref .n) {
    top: 3px;
  }

  @media (max-width: 900px) {
    .prose :global(.fig-ref .n) {
      left: 0;
    }

    .prose :global(.fig-ref + h3) {
      padding-left: var(--space-7);
    }
  }

  .prose :global(p + p) {
    margin-top: var(--space-4);
  }

  .prose :global(ul) {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cs-notes {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: var(--space-2);
  }

  @media (max-width: 1099px) {
    .cs-body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
