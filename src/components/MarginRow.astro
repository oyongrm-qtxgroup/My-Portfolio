---
// One logbook row: a label in the margin column, content right of the red line.
// `hideLabel` hides the label from assistive tech when a heading in the row already
// says the same thing, so screen readers don't announce it twice.
interface Props {
  index?: number;
  ruled?: boolean;
  id?: string;
  class?: string;
  hideLabel?: boolean;
}

const { index = 0, ruled = false, id, class: className, hideLabel = false } = Astro.props;
---

<section class:list={['row', { ruled }, className]} id={id}>
  <div class="mar label" style={`--i: ${index}`} aria-hidden={hideLabel ? 'true' : undefined}>
    <slot name="label" />
  </div>
  <div class="body">
    <slot />
  </div>
</section>
