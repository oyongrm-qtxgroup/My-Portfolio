---
// The full log, grouped by month. Used by /log/ and the per-project filter pages.
import Base from '../layouts/Base.astro';
import MarginRow from './MarginRow.astro';
import LogRow from './LogRow.astro';
import { getLog, getLogFilters, monthKey, monthName, type LogEntry } from '../lib/content';

interface Props {
  /** A case-study slug, 'client-work', or undefined for everything. */
  filter?: string;
}

const { filter } = Astro.props;
const [all, filters] = await Promise.all([getLog(), getLogFilters()]);

const entries = all.filter((e) => {
  if (!filter) return true;
  if (filter === 'client-work') return !e.data.work;
  return e.data.work?.id === filter;
});

const months = new Map<string, LogEntry[]>();
for (const e of entries) {
  const key = monthKey(e.data.date);
  months.set(key, [...(months.get(key) ?? []), e]);
}

const current = filters.find((f) => f.slug === filter);
const title = current ? `${current.label} — the log` : 'The log — R. Oyong';
---

<Base
  title={title}
  description="What shipped, week by week: each change in one sentence, written for the person who uses the software."
>
  <MarginRow index={0}>
    <Fragment slot="label">Index</Fragment>
    <div class="log-head">
      <h1 class="display">The log</h1>
      <p class="lede">
        What shipped, week by week, written the way I write it for clients: what changed and why it
        matters to the person using it.
      </p>
      <nav aria-label="Filter the log" class="filters mono">
        <a href="/log/" class="chip" aria-current={!filter ? 'page' : undefined}>All · {all.length}</a>
        {
          filters.map((f) => (
            <a
              href={`/log/${f.slug}/`}
              class="chip"
              aria-current={f.slug === filter ? 'page' : undefined}
            >
              {f.label} · {f.count}
            </a>
          ))
        }
      </nav>
    </div>
  </MarginRow>

  {
    [...months.entries()].map(([key, list], i) => {
      const d = list[0].data.date;
      return (
        <MarginRow ruled index={i + 1}>
          <Fragment slot="label">
            <span class="month title">{monthName(d)}</span>
            <span class="year">{d.getUTCFullYear()}</span>
          </Fragment>
          <h2 class="visually-hidden" id={`m-${key}`}>
            {monthName(d)} {d.getUTCFullYear()}
          </h2>
          <div class="month-list">
            {list.map((e, j) => (
              <LogRow entry={e} index={j} dayOnly />
            ))}
          </div>
        </MarginRow>
      );
    })
  }
</Base>

<style>
  .log-head {
    padding: 32px 0 8px;
  }

  h1 {
    font-size: clamp(64px, 9vw, 112px);
    line-height: 0.9;
  }

  .lede {
    margin-top: 20px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--ink);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .chip:hover {
    text-decoration: underline;
  }

  .chip[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }

  .month {
    display: block;
    font-size: 30px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
  }

  .year {
    display: block;
    margin-top: 4px;
  }

  .month-list {
    margin-top: -8px;
  }

  @media (max-width: 760px) {
    .month {
      display: inline;
      font-size: 24px;
      margin-right: 8px;
    }

    .year {
      display: inline;
    }
  }
</style>
