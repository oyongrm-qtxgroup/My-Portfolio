---
// A project's figure drawn small, without words (DESIGN_PLAN G-02, Step 11): the
// same spec as the figure on its page (src/lib/figures.ts), so the two can't drift.
// Decorative: the project's name is always beside it.
import { layoutGlyph } from '../lib/figure';
import { figures, glyphFor, specKey } from '../lib/figures';

interface Props {
  /** The work entry's id. */
  work: string;
  /** Rendered width in px (the height follows the 3:2 frame). */
  width?: number;
  class?: string;
}

const { work, width = 120, class: className } = Astro.props;
const spec = figures[glyphFor[work]];
const g = spec && layoutGlyph(spec);
---

{
  g && (
    <svg
      class:list={['glyph', className]}
      viewBox={`0 0 ${g.width} ${g.height}`}
      width={width}
      height={(width * g.height) / g.width}
      aria-hidden="true"
      focusable="false"
      data-glyph={specKey(spec)}
      data-boxes={g.boxes.length}
    >
      {g.lines.map((l) => (
        <path class:list={['g-line', l.kind]} d={l.d} />
      ))}
      {g.boxes.map((b) => (
        <rect class:list={['g-box', b.kind]} x={b.x} y={b.y} width={b.w} height={b.h} />
      ))}
    </svg>
  )
}

<style>
  .glyph {
    display: block;
    overflow: visible;
  }

  .g-box,
  .g-line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .g-box.model {
    stroke-dasharray: 3 2;
  }

  .g-box.person {
    stroke-width: 2.25;
  }

  .g-line.fail {
    stroke: var(--margin);
    stroke-dasharray: 1 3;
    stroke-linecap: round;
    stroke-width: 1.75;
  }
</style>
